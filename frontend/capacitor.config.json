{
  "appId": "com.vocalia.app",
  "appName": "Vocalia",
  "webDir": "dist",
  "plugins": {
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true
    },
    "StatusBar": {
      "style": "DARK"
    }
  },
  "android": {
    "allowMixedContent": true
  },
  "ios": {
    "contentInset": "automatic",
    "preferredContentMode": "mobile",
    "scheme": "Vocalia"
  },
  "server": {
    "androidScheme": "https",
    "iosScheme": "https",
    "cleartext": true
  }
}
